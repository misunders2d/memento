            }
          ],
          "default": null
        },
        "memory_until": {
          "anyOf": [
            {
              "format": "date-time",
              "type": "string"
            },
            {
              "const": "",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        }
      },
      "type": "object"
