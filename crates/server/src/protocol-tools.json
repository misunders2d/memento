              "type": "string"
            },
            {
              "const": "",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "source": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "memory_since": {
          "anyOf": [
            {
              "format": "date-time",
              "type": "string"
            },
            {
              "const": "",
              "type": "string"
