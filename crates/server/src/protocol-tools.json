  {
    "name": "link",
    "title": "Link",
    "description": "Add an evidence-backed directional relation from a to b.",
    "inputSchema": {
      "additionalProperties": false,
      "properties": {
        "command": {
          "additionalProperties": false,
          "properties": {
            "command_id": {
              "maxLength": 512,
              "minLength": 1,
              "type": "string"
            },
            "actor": {
              "maxLength": 256,
              "minLength": 1,
              "type": "string"
            },
            "why": {
              "minLength": 1,
              "type": "string"
            },
            "evidence": {
              "items": {
                "additionalProperties": false,
                "properties": {
                  "episode_id": {
                    "anyOf": [
                      {
                        "maxLength": 64,
                        "minLength": 1,
                        "type": "string"
                      },
                      {
                        "type": "null"
                      }
                    ],
                    "default": null
                  },
                  "quote": {
                    "minLength": 1,
                    "type": "string"
                  },
                  "occurrence": {
                    "anyOf": [
                      {
                        "minimum": 0,
                        "type": "integer"
                      },
                      {
                        "type": "null"
                      }
                    ],
                    "default": null
                  }
                },
                "required": [
                  "quote"
                ],
                "type": "object"
              },
              "maxItems": 100,
              "minItems": 1,
              "type": "array"
            },
            "source": {
              "anyOf": [
                {
                  "maxLength": 256,
                  "minLength": 1,
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "default": null
            },
            "conversation_id": {
              "anyOf": [
                {
                  "maxLength": 512,
                  "minLength": 1,
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "default": null
            },
            "a": {
              "maxLength": 64,
              "minLength": 1,
              "type": "string"
            },
            "rel": {
              "description": "Evidence-backed directional predicate in lowercase snake_case. Examples are suggestions, not an allowlist; supersedes is reserved for atomic supersession.",
              "examples": [
                "belongs_to",
                "follows_up_on",
                "works_in",
                "decided_by",
                "mentions",
                "part_of",
                "caused_by",
                "owned_by",
                "related_to"
              ],
              "not": {
                "const": "supersedes"
              },
              "pattern": "^[a-z][a-z0-9_]{0,63}$",
              "type": "string"
            },
            "b": {
              "maxLength": 64,
              "minLength": 1,
              "type": "string"
            }
          },
          "required": [
            "command_id",
            "actor",
            "why",
            "evidence",
            "a",
            "rel",
            "b"
          ],
          "type": "object"
        }
      },
      "required": [
        "command"
      ],
      "type": "object"
    },
    "outputSchema": {
      "additionalProperties": true,
      "type": "object"
    },
    "_meta": {
      "fastmcp": {
        "tags": []
      }
    }
