[
  {
    "name": "recall",
    "title": "Recall",
    "description": "Recall memories, or omit query for recent activity; since/source filter raw evidence.\n\nWhen choosing how to carry out a task and automatic context is insufficient, consult relevant prior experiences.",
    "inputSchema": {
      "additionalProperties": false,
      "properties": {
        "query": {
          "default": "",
          "type": "string"
        },
        "effort": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": "normal"
        },
        "limit": {
          "default": 10,
          "type": "integer"
        },
        "scope": {
          "anyOf": [
            {
              "enum": [
                "personal",
                "professional",
                ""
              ],
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "since": {
          "anyOf": [
            {
              "format": "date-time",
              "type": "string"
            },
            {
              "const": "",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "source": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        }
      },
      "type": "object"
    },
    "_meta": {
      "fastmcp": {
        "tags": []
      }
    }
  },
  {
